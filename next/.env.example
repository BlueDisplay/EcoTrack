# Variables de entorno para EcoTrack Next.js
# Copiar a .env.local para desarrollo local

# Neon PostgreSQL (opcional — sin ella funciona todo excepto persistencia de reportes)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/ecotrack?sslmode=require

# NextAuth (obligatorio para auth)
AUTH_SECRET=genera_con_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Roboflow — YA ESTÁ HARDCODEADA en api/analyze/route.ts
# No es necesario configurarla aquí
