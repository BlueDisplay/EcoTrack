# Variables de entorno para EcoTrack Next.js
# Copiar a .env.local para desarrollo local

# Neon PostgreSQL (recomendado para persistencia)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/ecotrack?sslmode=require

# NextAuth (obligatorio para auth)
AUTH_SECRET=genera_con_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Roboflow (obligatorio para detección IA real)
ROBOFLOW_API_KEY=tu_roboflow_api_key
ROBOFLOW_MODEL=visual-pollution-detection-04jk5/3

# Vercel Blob (obligatorio en producción para guardar fotos de reportes)
# Si no se define, /api/upload usa fallback local en public/uploads
BLOB_READ_WRITE_TOKEN=tu_vercel_blob_token
